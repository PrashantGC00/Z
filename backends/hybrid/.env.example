PORT=3000
VERSION="0.0.1"
ARCH="hybrid"
LOG_LEVEL="info"
OTEL_SERVICE_NAME="z-hybrid"

CORS_ORIGINS="http://localhost:5173,http://localhost:8090"
DATABASE_URL="postgresql://test:testtest@localhost:5433/z_hybrid"
OTEL_EXPORTER="http://localhost:4318/v1/traces"
REDIS_URL="redis://localhost:6380"

POSTGRES_DB="z_hybrid"
POSTGRES_USER="test"
POSTGRES_PASSWORD="testtest"

S3_ACCESS_KEY="minioadmin"
S3_SECRET_KEY="minioadmin"
S3_BUCKET="media"
S3_ENDPOINT="http://localhost:9002"

MEDIA_ADAPTER="remote"

# Generate key:
#   openssl genpkey -algorithm ed25519 -out private.pem
#   openssl pkey -in private.pem -pubout -out public.pem
#   base64 -w0 private.pem   # -> JWT_PRIVATE_KEY
#   base64 -w0 public.pem    # -> JWT_PUBLIC_KEY
JWT_PRIVATE_KEY=
JWT_PUBLIC_KEY=
JWT_ISSUER=z-hybrid
JWT_AUDIENCE=z
ACCESS_TOKEN_TTL_SECONDS=900
