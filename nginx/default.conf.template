limit_req_zone $binary_remote_addr zone=monolith_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=hybrid_api:10m rate=10r/s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

map $uri $problem_instance {
  "~^[A-Za-z0-9/._~:@!$&'()*+,;=-]*$"  $uri;
  default                              "";
}

server {
  listen 8081;
  server_name _;

  resolver 127.0.0.11 valid=10s ipv6=off;

  client_max_body_size 10m;

  error_page 405 @problem_405;
  error_page 429 @problem_429;
  error_page 502 = @problem_502;
  error_page 503 = @problem_503;
  error_page 504 = @problem_504;

  location @problem_502 {
    default_type application/problem+json;
    add_header X-Request-Id $request_id always;
    return 502 '{"type":"about:blank","title":"Bad Gateway","status":502,"detail":"The upstream service is unavailable","instance":"$problem_instance","traceId":"$request_id"}';
  }

  location @problem_503 {
    default_type application/problem+json;
    add_header Retry-After 1 always;
    add_header X-Request-Id $request_id always;
    return 503 '{"type":"about:blank","title":"Service Unavailable","status":503,"detail":"The service is temporarily unavailable","instance":"$problem_instance","traceId":"$request_id"}';
  }

  location @problem_504 {
    default_type application/problem+json;
    add_header Retry-After 1 always;
    add_header X-Request-Id $request_id always;
    return 504 '{"type":"about:blank","title":"Gateway Timeout","status":504,"detail":"The upstream service timed out","instance":"$problem_instance","traceId":"$request_id"}';
  }

  location @problem_429 {
    default_type application/problem+json;
    add_header Retry-After 1 always;
    add_header X-Request-Id $request_id always;
    return 429 '{"type":"about:blank","title":"Too Many Requests","status":429,"detail":"Rate limit exceeded","instance":"$problem_instance","traceId":"$request_id"}';
  }

  location @problem_405 {
    default_type application/problem+json;
    add_header Allow "GET, HEAD, POST, PUT, PATCH, DELETE, OPTIONS" always;
    add_header X-Request-Id $request_id always;
    return 405 '{"type":"about:blank","title":"Method Not Allowed","status":405,"detail":"The requested method is not allowed","instance":"$problem_instance","traceId":"$request_id"}';
  }

  location /v1/ {
    limit_req zone=monolith_api burst=20 nodelay;
    limit_req_status 429;

    set $backend ${MONOLITH_UPSTREAM};

    proxy_pass http://$backend;
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id      $request_id;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    proxy_connect_timeout 5s;
    proxy_send_timeout    30s;
    proxy_read_timeout    30s;
  }
}

