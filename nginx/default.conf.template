limit_req_zone $binary_remote_addr zone=monolith_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=microservices_api:10m rate=10r/s;
limit_req_zone $binary_remote_addr zone=hybrid_api:10m rate=10r/s;

map $http_upgrade $connection_upgrade {
  default upgrade;
  ''      '';
}

map $uri $problem_instance {
  "~^[A-Za-z0-9/._~:@!$&'()*+,;=-]*$"  $uri;
  default                              "";
}

# ── monolith ────────────────────────────────────────────────────────────────
server {
  listen 8081;
  server_name _;

  resolver 127.0.0.11 valid=10s ipv6=off;

  client_max_body_size 10m;

  include /etc/nginx/snippets/problem-errors.conf;

  location /v1/ {
    limit_req zone=monolith_api burst=20 nodelay;
    limit_req_status 429;

    set $backend ${MONOLITH_UPSTREAM};

    proxy_pass http://$backend;
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id      $request_id;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    proxy_connect_timeout 5s;
    proxy_send_timeout    30s;
    proxy_read_timeout    30s;
  }
}

# ── microservices ───────────────────────────────────────────────────────────
server {
  listen 8082;
  server_name _;

  resolver 127.0.0.11 valid=10s ipv6=off;

  client_max_body_size 10m;

  include /etc/nginx/snippets/problem-errors.conf;

  location = /v1/health {
    limit_req zone=microservices_api burst=20 nodelay;
    limit_req_status 429;

    set $backend ${IDENTITY_UPSTREAM};

    proxy_pass http://$backend;
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id      $request_id;

    proxy_connect_timeout 5s;
    proxy_send_timeout    30s;
    proxy_read_timeout    30s;
  }

  location /v1/ {
    default_type application/problem+json;
    add_header X-Request-Id $request_id always;
    return 404 '{"type":"about:blank","title":"Not Found","status":404,"detail":"No route matches this path","instance":"$problem_instance","traceId":"$request_id"}';
  }
}

# ── hybrid ──────────────────────────────────────────────────────────────────
server {
  listen 8083;
  server_name _;

  resolver 127.0.0.11 valid=10s ipv6=off;

  client_max_body_size 10m;

  include /etc/nginx/snippets/problem-errors.conf;

  location /v1/ {
    limit_req zone=hybrid_api burst=20 nodelay;
    limit_req_status 429;

    set $backend ${HYBRID_UPSTREAM};

    proxy_pass http://$backend;
    proxy_http_version 1.1;

    proxy_set_header Host              $host;
    proxy_set_header X-Real-IP         $remote_addr;
    proxy_set_header X-Forwarded-For   $proxy_add_x_forwarded_for;
    proxy_set_header X-Forwarded-Proto $scheme;
    proxy_set_header X-Request-Id      $request_id;
    proxy_set_header Upgrade           $http_upgrade;
    proxy_set_header Connection        $connection_upgrade;

    proxy_connect_timeout 5s;
    proxy_send_timeout    30s;
    proxy_read_timeout    30s;
  }
}
