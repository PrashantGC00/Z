# Base URLs for each backend: the nginx gateway ports. All three implement api/openapi.yaml.
VITE_MONOLITH_URL=http://localhost:8081/v1
VITE_MICROSERVICES_URL=http://localhost:8082/v1
VITE_HYBRID_URL=http://localhost:8083/v1
# Backend selected on first load: mock | monolith | microservices | hybrid
VITE_DEFAULT_BACKEND=mock
